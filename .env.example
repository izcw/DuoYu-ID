DUOYU_ADDR=0.0.0.0:5252
DUOYU_ORIGIN=http://localhost:5252
DATABASE_URL=postgres://duoyu:duoyu_dev_only@localhost:55432/duoyu?sslmode=disable
DUOYU_DATA_DIR=./data
DUOYU_ADMIN_EMAIL=2405824084@qq.com
# Bootstrap only: set a strong password, then remove after administrator creation.
DUOYU_ADMIN_PASSWORD=
# Generate 32 random bytes as 64 hex characters; persist this key across restarts.
DUOYU_SECRET=
DUOYU_DEV=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=2405824084@qq.com
SMTP_PASSWORD=
SMTP_FROM=2405824084@qq.com
# Only local Mailpit supports this. Keep false for QQ.
SMTP_PLAIN_LOCAL=false

# Runtime role: combined (default), api or worker
DUOYU_ROLE=combined
# Comma-separated CIDRs of actual trusted proxies; empty ignores forwarded headers
DUOYU_TRUSTED_PROXIES=

