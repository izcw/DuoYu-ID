{
  "name": "art-design-pro",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.8.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "node scripts/build-icons.mjs && vue-tsc --noEmit && vite build && vite build --config vite.login.config.ts",
    "test:dependencies": "node tests/dependency-compat.mjs",
    "serve": "vite preview",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "commit": "git-cz",
    "clean:dev": "tsx scripts/clean-dev.ts"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.5",
    "@tailwindcss/vite": "^4.3.4",
    "@vue/reactivity": "^3.5.44",
    "@vueuse/core": "^13.9.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "next",
    "axios": "^1.21.0",
    "crypto-js": "^4.2.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.12",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.11.0",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.6.4",
    "xgplayer": "^3.0.27",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@iconify-json/ri": "^1.2.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsqr": "^1.4.0",
    "lint-staged": "^15.5.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.107.1",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-demi": "^0.14.10",
    "vue-img-cutter": "^3.1.1",
    "vue-tsc": "~3.3.14"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "11.0.1",
      "eslint>minimatch": "11.0.1",
      "stylelint-config-recommended-vue>stylelint-config-recommended": "^16.0.0"
    }
  }
}
